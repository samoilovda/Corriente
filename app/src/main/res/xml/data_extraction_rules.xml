<?xml version="1.0" encoding="utf-8"?>
<!--
  F3.2 / ADR-013: ничего не вывозится ни в облачный бэкап (API 31+), ни при переносе
  устройство-на-устройство. Данные пользователя переносятся только собственным JSON-бэкапом.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
