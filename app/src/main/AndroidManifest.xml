<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Инвариант I-24 (ADR-013): приложение не умеет обращаться в сеть в принципе — разрешения INTERNET нет и
         не будет; итоговый манифест проверяет задача verify<Variant>MergedManifest (allowlist в buildSrc,
         PRIVACY.md — список разрешений с объяснениями).
         ACCESS_NETWORK_STATE тянет WorkManager ради сетевых ограничений, которых в проекте нет — убираем. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".CorrienteApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Corriente"
        android:supportsRtl="true">
        <!-- Адаптивная иконка (F3.1): mipmap-anydpi-v26 — minSdk 26, растровые фолбэки не нужны. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Corriente">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- R4.4: статические ярлыки приложения (долгое нажатие на иконку). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".quick.QuickExpenseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Corriente.Translucent" />
        <activity
            android:name=".quick.ChangeActiveAccountActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Corriente.Translucent" />

        <!-- R4.0: ловит внутреннюю ретрансляцию ACTION_APPWIDGET_ENABLED/UPDATE от
             CorrienteWidgetReceiver (:widget) — сами эти системные действия приходят явным
             intent'ом прямо на провайдера, поймать их отдельным receiver'ом здесь нельзя. -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.corriente.app.action.WIDGET_PLACEMENT_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- R1.2: «Отправить бэкап» — временный файл в cache/share отдаётся системному шерингу
             через FileProvider (часть androidx.core, отдельной зависимости не требует).
             Не экспортирован, доступ только по разовому URI-гранту (FLAG_GRANT_READ_URI_PERMISSION),
             без разрешений (I-24) — сеть, если она вообще случится, трогает чужое приложение. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
